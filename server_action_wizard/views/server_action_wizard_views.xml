<odoo>
    <record id="view_server_action_wizard_form" model="ir.ui.view">
        <field name="name">server.action.wizard.form</field>
        <field name="model">server.action.wizard</field>
        <field name="arch" type="xml">
            <form string="Run Server Action">
                <group>
                    <field name="model_id" />
                    <field
                        name="server_action_id"
                        domain="[('model_id', '=', model_id), ('can_run_from_wizard', '=', True)]"
                    />
                </group>
                <group>
                    <field
                        name="param_date_start"
                        string="Date Start"
                        invisible="not server_action_id.param_label_date_start"
                    />
                    <field
                        name="param_date_end"
                        string="Date End"
                        invisible="not server_action_id.param_label_date_end"
                    />
                    <field
                        name="param_1"
                        string="Parameter 1"
                        invisible="not server_action_id.param_label_1"
                    />
                    <field
                        name="param_2"
                        string="Parameter 2"
                        invisible="not server_action_id.param_label_2"
                    />
                </group>
                <footer>
                    <button
                        name="run_server_action"
                        type="object"
                        string="Run"
                        class="btn-primary"
                    />
                    <button string="Cancel" special="cancel" class="btn-secondary" />
                </footer>
            </form>
        </field>
    </record>

    <act_window
        id="action_server_action_wizard"
        name="Run Server Action Wizard"
        res_model="server.action.wizard"
        view_mode="form"
        target="new"
    />

    <menuitem
        id="menu_server_action_wizard"
        name="Server Action Wizard"
        parent="base.menu_ir_actions"
        action="action_server_action_wizard"
        sequence="100"
    />
</odoo>
