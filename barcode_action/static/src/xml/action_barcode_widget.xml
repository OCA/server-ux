<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

    <t t-name="barcode_action.ActionBarcodeField">
        <div class="o_barcode_action_scanner" aria-hidden="true">
            <div class="o_barcode_action_scanner_bars">
                <span class="o_barcode_action_scanner_line" />
            </div>
        </div>
    </t>

    <t t-name="barcode_action.SystrayItem">
        <div>
            <button
                class="o_nav_entry btn"
                title="Scan a barcode"
                accesskey="b"
                t-on-click="onClick"
            >
                <i class="fa fa-barcode" />
            </button>
        </div>
    </t>

</templates>
