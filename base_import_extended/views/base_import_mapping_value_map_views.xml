<?xml version="1.0" encoding="utf-8" ?>
<odoo>

<record id="base_import_mapping_template_tree_view" model="ir.ui.view">
    <field name="name">base.import.mapping.value.map.tree</field>
    <field name="model">base_import.mapping.value.map</field>
    <field name="arch" type="xml">
        <tree editable="bottom">
            <field name="mapping_ids" widget="many2many_tags" />
            <field name="value" />
            <field name="new_value" />
<!--            <field name="res_model" column_invisible="1" />-->
<!--            <field name="update_path" widget="DynamicModelFieldSelectorChar" class="oe_inline" options="{'model': 'res_model'}"/>-->
            <field name="new_value_ref" />
        </tree>
    </field>
</record>

<record id="action_base_import_mapping_value_map" model="ir.actions.act_window">
    <field name="name">Import mapping value map</field>
    <field name="type">ir.actions.act_window</field>
    <field name="res_model">base_import.mapping.value.map</field>
    <field name="view_mode">tree</field>
</record>

<menuitem
        id="menu_base_import_mapping_value_map"
        action="action_base_import_mapping_value_map"
        parent="base.menu_custom"
        sequence="130"
        groups="base.group_no_one"
    />

</odoo>
