<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//app[@name='general_settings']" position="inside">
                <block title="Locale" id="locale_settings">
                    <setting
                        id="date_format_setting"
                        string="Date Format"
                        company_dependent="1"
                        help="Configure global override of date format for all users."
                    >
                        <field name="date_format" nolabel="1" />
                    </setting>
                    <setting
                        id="time_format_setting"
                        string="Time Format"
                        company_dependent="1"
                        help="Configure global override of time format for all users."
                    >
                        <field name="time_format" nolabel="1" />
                    </setting>
                    <setting
                        id="week_start_setting"
                        string="Week Start"
                        company_dependent="1"
                        help="Configure global override of week start for all users."
                    >
                        <field name="week_start" nolabel="1" />
                    </setting>
                    <setting
                        id="decimal_point_setting"
                        string="Decimal Separator"
                        company_dependent="1"
                        help="Configure global override of decimal separator for all users."
                    >
                        <field name="decimal_point" nolabel="1" />
                    </setting>
                    <setting
                        id="thousands_sep_setting"
                        string="Thousands Separator"
                        company_dependent="1"
                        help="Configure global override of thousands separator for all users."
                    >
                        <field name="thousands_sep" nolabel="1" />
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
