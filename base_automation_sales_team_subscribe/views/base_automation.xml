<odoo>

    <record model="ir.ui.view" id="base_automation_form_view">
        <field name="model">base.automation</field>
        <field name="inherit_id" ref="base_automation.view_base_automation_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_ids']" position="after">
                <field
                    name="subscribe_team_ids"
                    attrs="{'invisible': [('state', '!=', 'followers')]}"
                    widget="many2many_tags"
                />
            </xpath>
        </field>
    </record>
</odoo>
