<odoo>
    <record id="tier_correction_wizard_view_form" model="ir.ui.view">
        <field name="name">tier.correction.wizard.form</field>
        <field name="model">tier.correction.wizard</field>
        <field name="arch" type="xml">
            <form string="Change Reviewers">
                <group>
                    <field name="res_model" invisible="1" readonly="1" />
                    <field name="res_id" invisible="1" readonly="1" />
                </group>
                <field name="line_ids" nolabel="1">
                    <list editable="bottom" create="0" delete="0">
                        <field name="review_id" readonly="1" force_save="1" />
                        <field
                            name="original_reviewer_id"
                            readonly="1"
                            force_save="1"
                        />
                        <field name="allowed_reviewer_ids" column_invisible="1" />
                        <field
                            name="new_reviewer_id"
                            domain="[('id', 'in', allowed_reviewer_ids)]"
                        />
                    </list>
                </field>
                <footer>
                    <button
                        name="action_confirm"
                        string="Confirm"
                        type="object"
                        class="btn-primary"
                    />
                    <button special="cancel" string="Cancel" class="oe_link" />
                </footer>
            </form>
        </field>
    </record>
</odoo>
