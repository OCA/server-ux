<?xml version="1.0" ?>
<odoo>
    <record id="ir_model_access_view_tree" model="ir.ui.view">
        <field name="name">ir.model.access.list.base_import_manager</field>
        <field name="model">ir.model.access</field>
        <field name="inherit_id" ref="base.ir_access_view_tree" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='perm_unlink']" position="after">
                <field name="perm_import" />
            </xpath>
        </field>
    </record>
    <record id="ir_model_access_view_tree_edition" model="ir.ui.view">
        <field name="name">ir.model.access.list.edition.base_import_manager</field>
        <field name="model">ir.model.access</field>
        <field name="inherit_id" ref="base.ir_access_view_tree_edition" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='perm_unlink']" position="after">
                <field name="perm_import" />
            </xpath>
        </field>
    </record>
    <record id="ir_model_access_view_form" model="ir.ui.view">
        <field name="name">ir.model.access.form.base_import_manager</field>
        <field name="model">ir.model.access</field>
        <field name="inherit_id" ref="base.ir_access_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='perm_unlink']" position="after">
                <field name="perm_import" />
            </xpath>
        </field>
    </record>
</odoo>
