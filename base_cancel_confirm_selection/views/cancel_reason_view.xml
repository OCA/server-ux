<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="cancel_reason_list_view" model="ir.ui.view">
        <field name="name">cancel.reason.list.view</field>
        <field name="model">res.cancel.reason</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="description" />
                <field name="model_id" />
            </list>
        </field>
    </record>
    <record id="cancel_reason_form_view" model="ir.ui.view">
        <field name="name">cancel.reason.form.view</field>
        <field name="model">res.cancel.reason</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget
                        name="web_ribbon"
                        title="Archived"
                        bg_color="text-bg-danger"
                        invisible="active"
                    />
                    <group>
                        <group>
                            <field name="name" />
                            <field name="description" />
                        </group>
                        <group>
                            <field name="model_id" options="{'no_create': True}" />
                            <field name="model" invisible="1" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_cancel_reason" model="ir.actions.act_window">
        <field name="name">Cancel Reason</field>
        <field name="res_model">res.cancel.reason</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
        id="menu_action_cancel_reason_configuration"
        name="Cancel Reason Configuration"
        parent="base.menu_custom"
        action="action_cancel_reason"
    />
</odoo>
