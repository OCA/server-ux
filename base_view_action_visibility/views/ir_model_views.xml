<odoo>
    <record id="ir_model_view_form" model="ir.ui.view">
        <field name="model">ir.model</field>
        <field name="inherit_id" ref="base.view_model_form" />
        <field name="arch" type="xml">
            <xpath expr="//sheet/notebook" position="before">
                <group name="view_action_visibility" string="View Action Visibility">
                    <group>
                        <field
                            name="duplicate_allowed_group_ids"
                            widget="many2many_tags"
                        />
                    </group>
                    <group>
                        <field
                            name="delete_allowed_group_ids"
                            widget="many2many_tags"
                        />
                    </group>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
