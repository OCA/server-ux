<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field
            name="name"
        >res.config.settings.view.form.inherit.base.export.manager</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//block[@id='user_default_rights']" position="inside">
                <setting id="export_denied_by_default">
                    <field name="export_denied_by_default" />
                    <div class="text-muted">
                        When enabled, export access is unchecked by default
                        on newly created model access rights. Existing
                        access rights are not affected.
                    </div>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
