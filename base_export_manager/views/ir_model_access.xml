<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="ir_model_access_view_tree" model="ir.ui.view">
        <field name="name">ir.access.list.base_export_manager</field>
        <field name="model">ir.access</field>
        <field name="inherit_id" ref="base.ir_access_list_view" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='for_unlink']" position="after">
                <field name="perm_export" />
            </xpath>
        </field>
    </record>
    <record id="ir_model_access_view_form" model="ir.ui.view">
        <field name="name">ir.access.form.base_export_manager</field>
        <field name="model">ir.access</field>
        <field name="inherit_id" ref="base.ir_access_form_view" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='for_unlink']" position="after">
                <field name="perm_export" />
            </xpath>
        </field>
    </record>
</odoo>
