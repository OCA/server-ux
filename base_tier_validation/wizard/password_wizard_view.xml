<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_password_confirm_wizard" model="ir.ui.view">
        <field name="name">Password Wizard</field>
        <field name="model">password.wizard</field>
        <field name="type">form</field>
        <field name="arch" type="xml">
            <form string="Password Confirmation">
                <group>
                    <field colspan="2" name="password" password="True" nolabel="1" />
                </group>
                <footer>
                    <button
                        name="confirm_password"
                        string="Confirm"
                        type="object"
                        class="oe_highlight"
                    />
                    <button special="cancel" string="Cancel" class="oe_link" />
                </footer>
            </form>
        </field>
    </record>
</odoo>
